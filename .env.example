# Plaid API keys: https://dashboard.plaid.com -> Developers -> Keys.
# setup.py fills these in for you.
PLAID_CLIENT_ID=
PLAID_SECRET=
# production (real banks) or sandbox (fake test banks; log in with user_good / pass_good)
PLAID_ENV=production

# One access token per linked bank. setup.py adds these automatically.
# PLAID_TOKEN_CHASE=access-production-...
# PLAID_TOKEN_AMERICANEXPRESS=access-production-...

# Required whenever the server listens beyond localhost (any cloud deploy).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN=

# Optional. Defaults: HOST=127.0.0.1, PORT=8000.
# HOST=0.0.0.0
# PORT=8000
